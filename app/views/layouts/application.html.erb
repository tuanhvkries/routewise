<!DOCTYPE html>
<html>
  <head>
    <title>RouteWise - Plan your trip in the most effective and environmentally friendly way</title>
    <meta name="description" content="RouteWise helps you plan personalized travel itineraries with AI-powered recommendations.">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Favicon -->
    <%= favicon_link_tag "favicon.png", type: "image/png" %>
    <%= favicon_link_tag "favicon.ico", rel: "shortcut icon" %>

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="RouteWise - Plan Your Perfect Trip">
    <meta property="og:description" content="RouteWise helps you plan personalized travel itineraries with AI-powered recommendations.">
    <meta property="og:image" content="<%= image_url('cover-image.png') %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= image_url('cover-image.png') %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" rel="stylesheet" />
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% unless devise_controller? %>
      <%= render "shared/navbar" %>
    <% end %>

    <% if notice || alert %>
      <div class="rw-flash-wrap" data-controller="flash" data-flash-timeout-value="3500">
        <div class="rw-container">
          <% if notice %>
            <div class="rw-flash rw-flash--notice"><%= notice %></div>
          <% end %>

          <% if alert %>
            <div class="rw-flash rw-flash--alert"><%= alert %></div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if devise_controller? %>
      <main>
        <%= yield %>
      </main>
    <% else %>
      <main class="rw-container">
        <%= yield %>
      </main>
    <% end %>

    <%= render "shared/footer" %>
  </body>
</html>
