<div class="rw-container rw-trip-show">
  <h1 class="rw-trip-title">Your trip to "<%= @trip.city %>"</h1>

  <div class="rw-hero-trip-image">
    <%= image_tag @trip.image_url.presence || "trips/placeholder.jpg",
        alt: @trip.city,
        class: "rw-hero-trip-img" %>
  </div>

  <div class="rw-trip-grid">
    <!-- SUMMARY -->
    <section class="rw-card rw-card--summary">
      <h3 class="rw-card-title">Summary</h3>

      <ul class="rw-list">
        <li><strong>From:</strong> <%= @trip.departure %></li>
        <li><strong>Dates:</strong> <%= @trip.start_date %> → <%= @trip.end_date %></li>
        <li><strong>People:</strong> <%= @trip.people %></li>
        <li>
          <strong>Preferences:</strong>
          <%= @trip.preferences
                .map { |p| "#{preference_emoji(p.name)} #{p.name}" }
                .join(", ")
          %>
        </li>
      </ul>

      <div class="rw-space-top">
        <strong>Further preferences:</strong>

          <%= form_with model: @trip,
                      url: update_preferences_trip_path(@trip),
                      method: :patch,
                      id: "update-further-preferences-form",
                      data: {
                        controller: "loading",
                        action: "turbo:submit-start->loading#start"
                      } do |f| %>

          <%= f.text_area :further_preferences,
                          rows: 3,
                          class: "rw-input rw-input--full",
                          placeholder: "e.g. local food spots, vegan options, nightlife, kid-friendly places…" %>
        <% end %>
      </div>

      <div class="rw-card-actions rw-card-actions--split">
        <button type="submit"
                form="update-further-preferences-form"
                class="rw-btn rw-btn--primary">
          <i class="fa-solid fa-pen-to-square"></i> Update preferences
        </button>

        <%= link_to edit_trip_path(@trip), class: "rw-btn rw-btn--secondary" do %>
          <i class="fa-solid fa-sliders"></i> Adjust your trip
        <% end %>
      </div>
    </section>

    <!-- TRANSPORTATION -->
    <section class="rw-card">
      <h3 class="rw-card-title">Transportation</h3>

      <% if @transport_options.any? %>
        <div class="rw-transport-list">
          <% @transport_options.each do |t| %>
            <div class="rw-transport-item">
              <div class="rw-transport-mode">
                <%= t.mode.to_s.upcase %>

                <% if t == @greenest_transport %>
                  <span class="rw-badge rw-badge--green">
                    <i class="fa-solid fa-earth-europe"></i> Best for the planet
                  </span>
                <% end %>
            </div>

              <div class="rw-muted">
                <%# Display duration in hours: e.g., 6h18 instead of 378 min %>
                <%= minutes_to_hours(t.duration_minutes) %> •
                €<%= t.price %> •
                <%= t.co2_kg %> kg CO₂
                <span class="rw-eco-rating"><%= eco_rating_leaves(t.co2_kg) %></span>
              </div>

              <div class="rw-muted"><%= t.summary %></div>
            </div>
          <% end %>
        </div>

        <div class="rw-card-actions">
          <%= link_to travel_search_url(
                origin: @trip.departure,
                destination: @trip.city
              ),
              class: "rw-btn rw-btn--secondary",
              target: "_blank",
              rel: "noopener noreferrer" do %>
            <i class="fa-solid fa-route"></i> Book Transport
          <% end %>
        </div>
      <% else %>
        <p class="rw-muted">Transport options will appear here after generation.</p>
      <% end %>
    </section>
  </div>

  <h2 class="rw-section-title">Your itinerary in "<%= @trip.city %>"</h2>

  <div class="rw-hero-trip-image">
    <%= image_tag @trip.itinerary_image_url.presence || "trips/placeholder.jpg",
        alt: @trip.city,
        class: "rw-hero-trip-img" %>
  </div>

  <% if @days.any? %>
    <div class="rw-days">
      <% @days.each do |day| %>
        <section class="rw-card">
          <div class="rw-day-header">
            <span>Day <%= day.day_number %></span>
            <span><%= day.date %></span>
          </div>

          <% if day.activities.any? %>
            <div class="rw-activities">
              <% day.activities.each do |a| %>
                <div class="rw-activity">
                  <div class="rw-activity-title">
                    <%= a.starts_at&.strftime("%H:%M") %> - <%= a.title %>
                  </div>
                  <div class="rw-muted"><%= a.location %></div>
                  <ul class="rw-list">
                    <li><%= a.details %></li>
                  </ul>
                </div>
              <% end %>
            </div>

            <% day_markers = day.activities
                                .select { |a| a.latitude.present? && a.longitude.present? }
                                .map { |a| { title: a.title, location: a.location, lat: a.latitude, lng: a.longitude } } %>

            <% if day_markers.any? %>
              <div class="rw-map rw-map--small"
                   data-controller="map"
                   data-map-token-value="<%= ENV['MAPBOX_ACCESS_TOKEN'] %>"
                   data-map-markers-value="<%= day_markers.to_json %>">
              </div>
            <% end %>
          <% else %>
            <p class="rw-muted rw-space-top">Activities will appear here.</p>
          <% end %>
        </section>
      <% end %>
    </div>
  <% else %>
    <section class="rw-card">
      <p class="rw-muted">Your itinerary will appear here after generation.</p>
    </section>
  <% end %>

  <div class="rw-page-actions">
    <%= button_to save_trip_path(@trip), method: :patch, class: "rw-btn rw-btn--primary", data: { turbo: false } do %>
      <i class="fa-solid fa-heart"></i> Save your trip
    <% end %>

    <%= link_to export_trip_path(@trip), class: "rw-btn rw-btn--secondary", data: { turbo: false } do %>
      <i class="fa-solid fa-file-pdf"></i> Export your trip
    <% end %>
  </div>
</div>

<% if @trip.status == "generating" %>
  <!-- Mount your existing Stimulus loading controller -->
  <div id="rw-loading-hook" data-controller="loading"></div>

  <script>
    function startOverlayAndPoll() {
      // --- Start overlay via calling the controller method directly ---
      const hook = document.getElementById("rw-loading-hook");
      if (hook) {
        const app = window.Stimulus;
        if (app) {
          const controller = app.getControllerForElementAndIdentifier(hook, "loading");
          if (controller && typeof controller.start === "function") controller.start();
        }
      }

      // --- Poll trip status and reload when ready ---
      const statusUrl = "<%= status_trip_path(@trip) %>";

      let attempts = 0;
      const maxAttempts = 240;

      async function poll() {
        attempts += 1;

        try {
          const resp = await fetch(statusUrl, {
            headers: { "Accept": "application/json" },
            credentials: "same-origin"
          });
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);

          const data = await resp.json();

          if (data.status === "ready") {
            window.location.reload();
            return;
          }

          if (data.status === "failed") {
            alert("Trip generation failed:\n\n" + (data.generation_error || "Please try again."));
            return;
          }

          if (attempts >= maxAttempts) {
            alert("This is taking longer than expected. You can refresh or check back in My Trips.");
            return;
          }

          setTimeout(poll, 1000);
        } catch (e) {
          if (attempts >= maxAttempts) {
            alert("Unable to check trip status. Please refresh.");
            return;
          }
          setTimeout(poll, 1500);
        }
      }

      poll();
    }

    document.addEventListener("turbo:load", startOverlayAndPoll);
    document.addEventListener("DOMContentLoaded", startOverlayAndPoll);
  </script>
<% end %>
