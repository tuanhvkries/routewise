<div class="rw-trips-new">
  <h1 class="rw-title">Plan your trip</h1>

    <%= form_with model: @trip,
                  class: "rw-form",
                  data: {
                    controller: "loading",
                    action: "turbo:submit-start->loading#start"
                  } do |f| %>

    <% if @trip.errors.any? %>
      <div class="rw-errors">
        <ul>
          <% @trip.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="rw-grid">
      <!-- LEFT COLUMN -->
      <div class="rw-col">
        <div class="rw-field">
          <%= f.label :city, "Destination", class: "rw-label" %>
          <%= f.text_field :city, placeholder: "City", class: "rw-input" %>
        </div>

        <div class="rw-field">
          <%= f.label :departure, "Departure:", class: "rw-label" %>
          <%= f.text_field :departure, placeholder: "City", class: "rw-input" %>
        </div>

        <div class="rw-field" data-controller="date-range">
          <%= f.label :start_date, "Travel Dates", class: "rw-label" %>
          <input type="text"
                 class="rw-input"
                 placeholder="Select date range"
                 data-date-range-target="picker"
                 readonly>
          <%= f.hidden_field :start_date, data: { date_range_target: "startDate" } %>
          <%= f.hidden_field :end_date, data: { date_range_target: "endDate" } %>
        </div>

        <div class="rw-field" data-controller="slider" data-slider-min-value="100" data-slider-max-value="10000" data-slider-step-value="100" data-slider-value-value="<%= @trip.budget || 2000 %>" data-slider-show-value-value="true">
          <label class="rw-label">
            Budget: €<span data-slider-target="value" class="rw-slider-value"><%= (@trip.budget || 2000).to_i.to_fs(:delimited) %></span>
          </label>
          <%= f.range_field :budget,
                min: 100,
                max: 10000,
                step: 100,
                value: @trip.budget || 2000,
                class: "rw-slider",
                data: { slider_target: "input", action: "input->slider#updateValue" } %>
        </div>

        <div class="rw-field" data-controller="slider" data-slider-min-value="1" data-slider-max-value="10" data-slider-step-value="1" data-slider-value-value="<%= @trip.people || 2 %>" data-slider-show-value-value="true">
          <label class="rw-label">
            People: <span data-slider-target="value" class="rw-slider-value"><%= @trip.people || 2 %></span>
          </label>
          <%= f.range_field :people,
                min: 1,
                max: 10,
                step: 1,
                value: @trip.people || 2,
                class: "rw-slider",
                data: { slider_target: "input", action: "input->slider#updateValue" } %>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="rw-col">
        <div class="rw-field">
          <span class="rw-label">Preferences</span>

          <div class="rw-checks">
            <% @preferences.each do |pref| %>
              <label class="rw-pref-chip">
                <%= check_box_tag "trip[preference_ids][]",
                      pref.id,
                      @trip.preference_ids.include?(pref.id),
                      class: "rw-pref-checkbox" %>

                <span class="rw-pref-chip-content">
                  <span class="rw-pref-emoji"><%= preference_emoji(pref.name) %></span>
                  <span><%= pref.name %></span>
                </span>
              </label>

            <% end %>
          </div>
        </div>

        <div class="rw-field">
          <span class="rw-label">Further preferences</span>
          <%= f.text_area :further_preferences,
                placeholder: "e.g. local food spots, vegan options, nightlife, kid-friendly places…",
                rows: 6,
                class: "rw-textarea" %>
        </div>
      </div>
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <button type="submit" class="rw-btn rw-btn--primary">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Get your itineraries
          </button>
          <%= link_to root_path, class: "rw-btn rw-btn--secondary" do %>
            <i class="fa-solid fa-circle-xmark"></i> Back
          <% end %>
        </div>
    </div>
  <% end %>
</div>
